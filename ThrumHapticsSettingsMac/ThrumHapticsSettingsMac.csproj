<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThrumHapticsSettingsMac</RootNamespace>
    <AssemblyName>ThrumHapticsSettingsMac</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Cross-built from Windows. The SDK ad-hoc signs the arm64 apphost even
         when building on Windows (verified: LC_CODE_SIGNATURE is present), which
         matters because Apple Silicon refuses to execute unsigned binaries. -->
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>

    <!-- Framework-dependent ON PURPOSE: the .NET runtime is the user's to install,
         and bundling it would multiply the size of the package.

         This is the one place that choice bites silently. LogiPluginService
         carries a PRIVATE runtime, so Options+ installs nothing this process can
         use, and on macOS the .NET host reports a missing runtime on stderr with
         no dialog. Every machine this was developed on had .NET already, so the
         settings window simply never opened for the first user who did not - with
         haptics working fine throughout, since those run inside Logi's process.
         The plugin now names that case in its log, and the README documents it. -->
    <SelfContained>false</SelfContained>

    <!-- Any .NET from 10 upwards. See the same setting in ThrumHapticsSettings. -->
    <RollForward>Major</RollForward>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!-- ReadyToRun was TRIED HERE AND REMOVED. Do not add it back without new
         evidence; it is the obvious fix and it does not work.

         The first startup log pointed straight at JIT: 791ms before managed code
         ran at all, then 1250ms inside Avalonia initialisation - 76% of a 2.67s
         launch. R2R precompiles exactly that, so it should have been most of it.

         It bought 5%. Window-shown went 2671ms -> 2534ms, and time-to-Main got
         WORSE (791 -> 863ms), which puts the difference at noise. The bill was
         4MB of package, paid by Windows users too now that we ship dual.

         So the cost is not JIT. It is Avalonia's own startup - Skia, fonts,
         display setup - which no compiler switch removes. Attacking it means a
         lighter theme or a pre-warmed process. -->
    <PublishDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same arrangement as ThrumHapticsSettings on Windows: the event catalogue and
         waveform list are COMPILED IN rather than sent over the pipe, so both
         sides share one definition of what events exist and only values cross the
         process boundary. Keeping this is the main reason the macOS UI stays in
         C# rather than becoming a native Swift app - a transcribed copy of the
         catalogue would drift the first time an event is added. -->
    <Compile Include="..\ThrumHapticsPlugin\src\Config\HapticEvents.cs" Link="Shared\HapticEvents.cs" />
    <Compile Include="..\ThrumHapticsPlugin\src\Haptics\Waveforms.cs" Link="Shared\Waveforms.cs" />

    <!-- The pipe client is shared with the Windows settings application rather
         than copied. It has no UI in it and the protocol is identical, so a
         second copy would only be somewhere for the two to drift apart. -->
    <Compile Include="..\ThrumHapticsSettings\SettingsClient.cs" Link="Shared\SettingsClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SAME file the package uses as its Marketplace icon, linked rather than
         copied, so the Dock tile and the store listing cannot drift apart. A bare
         executable has no bundle for macOS to read an icon from, so this is loaded
         at runtime - see MacDockIcon. -->
    <None Include="..\assets\ThrumHaptics.png" Link="AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned, not floating. `dotnet add package` writes Version="*", which would
         quietly change the UI framework underneath a build we cannot test from
         Windows - the one place a surprise is most expensive here. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

</Project>
