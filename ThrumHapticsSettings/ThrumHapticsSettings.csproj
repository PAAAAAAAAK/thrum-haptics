<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThrumHapticsSettings</RootNamespace>
    <AssemblyName>ThrumHapticsSettings</AssemblyName>
    <LangVersion>latest</LangVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Framework-dependent ON PURPOSE. The runtime is the user's to install - on
         Windows the .NET host prompts for it by name - and bundling it would add
         roughly 70MB to an 11MB package, because WinForms cannot be trimmed.

         Logi Options+ does not provide one. LogiPluginService carries a private
         runtime of its own, so nothing it installs is visible to this process. -->
    <SelfContained>false</SelfContained>

    <!-- Any .NET from 10 upwards, not 10 alone. The default policy stops at the
         major version, so a machine carrying only .NET 11 would refuse to start
         this - the same closed door as having no runtime at all, reached by
         someone who did install .NET. -->
    <RollForward>Major</RollForward>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Ships inside the plugin package next to the plugin assembly. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- No debug information in a release build, as in the other two projects.
         Without this the compiler records the full path of the .pdb it wrote
         inside the assembly, and that path includes the home folder of whoever
         built it - which then ships to everyone who installs the plugin. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!-- Embedded in the EXE, which is what the taskbar, Alt-Tab and the window
         title bar read. Setting Form.Icon alone would leave the executable itself
         showing the generic .NET application icon.
         The .ico is generated from the same Icon256x256.png the package uses, so
         the settings window and the Marketplace listing cannot drift apart. -->
    <ApplicationIcon>..\assets\ThrumHaptics.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The event catalogue and waveform list are COMPILED INTO BOTH the plugin
         and this application, rather than sent over the pipe. Both sides then
         share one definition of what events exist and what each is called, and
         only the values (enabled, chosen waveform) ever cross the process
         boundary. Duplicating those lists instead would let them drift silently. -->
    <Compile Include="..\ThrumHapticsPlugin\src\Config\HapticEvents.cs" Link="Shared\HapticEvents.cs" />
    <Compile Include="..\ThrumHapticsPlugin\src\Haptics\Waveforms.cs" Link="Shared\Waveforms.cs" />
  </ItemGroup>

</Project>
